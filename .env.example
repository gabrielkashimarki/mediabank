# Copie para .env e preencha. Vazio = desligado ou valor padrão do código.
# Pode usar referências op://<cofre>/<item>/<campo> com `op run --env-file .env -- npm start`.

# Servidor
# porta HTTP (padrão 3000)
PORT=3000
# pasta do banco SQLite e das miniaturas (padrão dados)
DIR_DADOS=dados
# endereço público do painel, usado nos links de e-mail e no OAuth (padrão http://localhost:3000)
BASE_URL=http://localhost:3000
# 1 = cookie de sessão só por HTTPS (ligue em produção atrás de proxy TLS)
COOKIE_SEGURO=

# IA (OpenRouter)
# chave do OpenRouter para descrição, embedding e catálogo (sem ela, a IA fica desligada)
OPENROUTER_API_KEY=
# modelo de visão que descreve fotos e vídeos (padrão google/gemini-3.8-flash)
MODELO_DESCRICAO=
# modelo de embedding do texto (padrão openai/text-embedding-3-small)
MODELO_EMBEDDING=
# dimensão do embedding de texto (padrão 1536; mudar exige banco novo)
EMBED_DIM=
# modelo de embedding dos quadros de vídeo (padrão google/gemini-embedding-2)
MODELO_QUADRO=
# dimensão do embedding dos quadros (padrão 768)
DIM_QUADRO=
# modelo que monta o catálogo de possibilidades (padrão google/gemini-3.8-flash)
MODELO_CATALOGO=
# chave da TypeSafe (Jev), opcional: decide se e qual foto sugerir em /api/v1/fotos/sugerir
TYPESAFE_API_KEY=

# Google Drive (opcional; sem ele, importe de pasta local com scripts/importar-pasta.js)
# cliente OAuth do Google Cloud
GOOGLE_CLIENT_ID=
# segredo do cliente OAuth
GOOGLE_CLIENT_SECRET=
# refresh token gerado por scripts/autorizar-drive.js
GOOGLE_REFRESH_TOKEN=
# id do drive compartilhado com o acervo (vazio = tudo o que a conta vê)
DRIVE_ID=
# só para scripts/autorizar-drive.js: e-mail da conta que autoriza e cofre do 1Password onde o token fica
DRIVE_CONTA=
OP_COFRE=
# só para scripts/autorizar-drive.js: redirect URI do OAuth (padrão BASE_URL/oauth/callback)
OAUTH_REDIRECT=

# Agendador (ciclo automático de sync e IA)
# 1 = liga o agendador
AGENDADOR=
# minutos entre ciclos (padrão 15)
AGENDADOR_MINUTOS=
# 1 = traz fotos novas do Drive a cada ciclo
SYNC_AUTOMATICO=
# 1 = registra vídeos do Drive (sem baixar; o trabalhador baixa)
SYNC_VIDEO=
# fotos novas por ciclo (padrão 200)
SYNC_LIMITE=
# 1 = descreve as fotos novas com IA a cada ciclo
IA_AUTOMATICA=
# 1 = descreve os vídeos já processados pelo trabalhador
IA_VIDEO=
# fotos descritas por ciclo (padrão 50)
IA_LIMITE=
# chamadas de IA em paralelo (padrão 4)
IA_CONCORRENCIA=

# Portão técnico
# menor lado mínimo da foto em px (padrão 800)
TEC_MIN_LADO=
# nitidez mínima (padrão 30)
TEC_NITIDEZ_MIN=
# brilho médio mínimo, 0 a 255 (padrão 20)
TEC_BRILHO_MIN=
# brilho médio máximo, 0 a 255 (padrão 235)
TEC_BRILHO_MAX=
# menor lado mínimo do vídeo em px (padrão 720)
TEC_MIN_LADO_VIDEO=
# tremido máximo da cena (padrão 4)
TEC_TREMIDO_MAX=

# E-mail (convites e redefinição de senha; sem SMTP, não envia)
# servidor SMTP
SMTP_HOST=
# porta SMTP (465 = TLS)
SMTP_PORTA=465
# usuário SMTP
SMTP_USUARIO=
# senha SMTP
SMTP_SENHA=
# remetente, ex.: MediaBank <nao-responda@exemplo.com>
SMTP_REMETENTE=

# Trabalhador (py/videos.py e py/sinais.py, no ambiente de quem roda)
# endereço do MediaBank
MEDIABANK_URL=http://localhost:3000
# chave com escopo lote (node scripts/criar-chave.js lote)
MEDIABANK_LOTE_KEY=
